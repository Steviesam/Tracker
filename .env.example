# Copy to .env and fill in. Never commit .env.

# --- Required ---

# Session cookie signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters.
APP_SESSION_SECRET=

# Postgres connection string. `docker compose up -d` starts one on port 5434.
DATABASE_URL=postgresql://tracker:tracker_local_dev@localhost:5434/social_metrics?schema=public

# The same database, but a connection that is never pooled. Migrations take advisory
# locks and run DDL, which a transaction pooler drops. Locally there is no pooler, so
# this is simply a copy of DATABASE_URL; on Neon it is the host WITHOUT `-pooler`.
DIRECT_DATABASE_URL=postgresql://tracker:tracker_local_dev@localhost:5434/social_metrics?schema=public

# --- Optional ---

# Maximum upload size in megabytes. Defaults to 15.
# On Vercel set this to 4: their functions reject any request body over 4.5 MB before it
# reaches the app, and a limit the app knows about produces a clear message instead of a
# raw 413.
MAX_UPLOAD_MB=15


# =====================================================================
# Data providers
#
# Nothing is estimated or synthesised. A platform with no configured
# provider returns N/A for every metric, with the reason shown in the UI.
# =====================================================================

# --- YouTube: fully works for any public video ---
# Google Cloud console > enable "YouTube Data API v3" > create an API key.
# Free quota is 10,000 units/day; one request covers up to 50 videos.
# Provides: views, likes, comments, publish date, channel name.
# Not available: shares (YouTube Analytics, channel owner only).
YOUTUBE_API_KEY=

# --- Instagram: partial, official Business Discovery ---
# Requires your own Instagram Business/Creator account linked to a Facebook
# Page, plus a Facebook app with instagram_basic + pages_read_engagement.
# Provides: views, likes, comments, post date — but ONLY when the target is a
# public Business/Creator account. Personal and age-gated accounts return N/A.
# Not available: shares, saves. Rate limit: 1,000 queries/hour.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Business Discovery is queried by username, so the app resolves each post URL
# to its creator automatically via oEmbed — a creator column in the file is
# optional, and is only used as a shortcut when present.
# Needs the oEmbed Read feature on the app. Usually "{app-id}|{client-token}".
# Falls back to INSTAGRAM_ACCESS_TOKEN when left blank.
INSTAGRAM_OEMBED_TOKEN=

# --- Facebook: owned Pages only ---
# Meta restricts video/reel insights to a Page token held by someone with the
# ANALYZE task on that Page. There is NO official way to read metrics for a
# Page you do not manage, so arbitrary public Facebook URLs need the
# third-party provider below.
FACEBOOK_ACCESS_TOKEN=

# --- Third-party public-data provider (optional, off by default) ---
# The only way to read arbitrary public Instagram and Facebook URLs. These
# actors read public pages rather than calling an authorised platform API,
# which Meta's terms restrict — review the provider's terms and your own legal
# position before enabling. Billed per result by the provider.
# Requires APIFY_TOKEN plus at least one actor id.
#
# The two actors below are the ones this app has been verified against, and each
# has its input shape hard-coded in src/lib/providers/public-data.ts. Other actors
# will fall back to a generic `startUrls` input, which many do not accept — adding
# one usually means adding its input shape there too.
#
# apify~facebook-posts-scraper is NOT recommended: it only returns metrics when
# crawling a Page feed, and returns nothing for a direct /reel/ URL.
#
# For Instagram, data-slayer~instagram-post-details is preferred over
# apify~instagram-scraper because it returns Instagram's full metrics object,
# including share counts. The apify one omits shares, so they show as N/A.
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=data-slayer~instagram-post-details
APIFY_FACEBOOK_ACTOR=clappi~facebook-posts-reels-scraper

# --- Creator stats (optional) ---
# Powers the "Get creator stats" button: last 10 reels averaged, plus the
# account's engagement rate. Costs one lookup per creator on top of the
# per-link metrics, which is why it runs on demand rather than automatically.
# Without the profile actor you still get averages, but no follower count and
# therefore no engagement rate. YouTube needs neither — it uses YOUTUBE_API_KEY.
#
# The profile actor is also what the creator directory uses to replace a sheet's rounded
# follower count ("309k") with the exact one, when you click a card's "From sheet" label.
APIFY_INSTAGRAM_REELS_ACTOR=apify~instagram-reel-scraper
APIFY_INSTAGRAM_PROFILE_ACTOR=apify~instagram-profile-scraper
