generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // Migrations need a session-level connection: they take advisory locks and run DDL,
  // neither of which survives a transaction pooler like Neon's PgBouncer. So the app
  // talks through the pooled URL and `prisma migrate deploy` uses the direct one.
  // Locally both point at the same Postgres.
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  /// Always stored lowercase and trimmed so lookups are unambiguous.
  email        String   @unique
  name         String
  /// bcrypt hash. The plaintext password is never stored or logged.
  passwordHash String
  /// `OWNER` or `MEMBER`. The first account to sign up owns the deployment; only an owner
  /// can invite, which is what keeps signup closed without a password in an env var.
  role         String   @default("MEMBER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?

  invitesSent Invite[] @relation("InvitedBy")

  @@index([email])
}

/**
 * An email the owner has allowed to sign up.
 *
 * Signup is otherwise closed. Without this, anyone who finds the URL can create an account
 * and spend the deployment's provider credits — the app has no other barrier, since it
 * reports on public data and needs no per-user credentials.
 *
 * The row is kept after the account exists rather than deleted, so the owner can see who
 * was let in and revoke a future re-signup.
 */
model Invite {
  id String @id @default(cuid())

  /// Lowercased and trimmed, matching User.email, so the comparison cannot miss.
  email String @unique

  invitedBy   User?   @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById String?

  /// Set when the invited person actually signs up, so the list shows who is still pending.
  acceptedAt DateTime?

  createdAt DateTime @default(now())

  @@index([email])
}

/**
 * One rate-limit window.
 *
 * In-process counters are useless on a serverless host: every instance keeps its own map,
 * so "five signups an hour" becomes five per instance per hour, and a password guesser
 * simply gets spread across instances. This is the same database the app already needs,
 * which is enough for the traffic a tool like this sees.
 */
model RateLimit {
  /// The thing being limited, e.g. `login:203.0.113.4`.
  key String @id

  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/**
 * One Instagram creator in the discovery directory.
 *
 * This is a directory the team maintains by uploading a sheet, not scraped data. Instagram
 * exposes no structured state, city or niche for an account, so those three can only come
 * from a source that already knows them.
 *
 * Every field except the username is nullable: a row with a handle and a city is still
 * worth keeping, and a filter simply will not match it on the fields it lacks.
 */
model Creator {
  id String @id @default(cuid())

  /// Lowercased, no leading "@". The natural key, so re-uploading a sheet updates in place.
  username    String  @unique
  displayName String?

  state String?
  city  String?

  /// Categories as tags, because sheets write them run-on: `Fashion/lifestyle/ugc` is one
  /// creator in three categories, and each should find them.
  niches String[]

  /// The best count known, whatever its source. Everything filters, sorts and displays
  /// this one number, so there is never a second figure to reconcile.
  followers Int?

  /// `sheet` or `live`. Sheets round ("309k"), so a live value is never replaced by a
  /// later import, and the UI can say which one the user is looking at.
  followersSource String?

  /// When the live lookup ran. Null while the count is still the sheet's.
  followersCheckedAt DateTime?

  /// Free-text extras from the sheet that do not map to a column, kept so nothing is lost.
  notes String?

  /// Filename of the upload this row last came from, so a bad import can be traced back.
  sourceFile String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Discovery filters on these, and sorts by followers.
  @@index([state])
  @@index([city])
  @@index([followers])
  @@index([state, city])
  /// Array containment needs GIN; a b-tree cannot answer "has this tag".
  @@index([niches], type: Gin)
}

/**
 * One login's Metrics and Engagement work: the uploaded/pasted links, their fetched
 * numbers, and any creator averages already looked up.
 *
 * Held in Postgres rather than process memory because a Vercel deploy is many short-lived
 * instances that do not share a Map. Refresh keeps this row; logout deletes it. The
 * creator directory above is a different thing — it is the team's dataset and outlives
 * any one login.
 */
model WorkSession {
  /// Matches the `sid` in the signed cookie.
  sid String @id

  payload Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}
