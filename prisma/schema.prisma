generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // Migrations need a session-level connection: they take advisory locks and run DDL,
  // neither of which survives a transaction pooler like Neon's PgBouncer. So the app
  // talks through the pooled URL and `prisma migrate deploy` uses the direct one.
  // Locally both point at the same Postgres.
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  /// Always stored lowercase and trimmed so lookups are unambiguous.
  email        String   @unique
  name         String
  /// bcrypt hash. The plaintext password is never stored or logged.
  passwordHash String
  /// `OWNER`, `MANAGER` or `MEMBER`. The first account to sign up owns the deployment; only
  /// an owner can invite, which is what keeps signup closed without a password in an env
  /// var. A manager runs the floor — assigns work and sees everyone's — but not the money.
  role         String   @default("MEMBER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?

  invitesSent Invite[] @relation("InvitedBy")

  campaignsManaged Campaign[]           @relation("CampaignManager")
  influencersOwned CampaignInfluencer[] @relation("InfluencerAssignee")
  tasksAssigned    Task[]               @relation("TaskAssignee")
  tasksCreated     Task[]               @relation("TaskCreator")
  activities       Activity[]           @relation("ActivityActor")
  workDays         WorkDay[]

  @@index([email])
}

/**
 * An email the owner has allowed to sign up.
 *
 * Signup is otherwise closed. Without this, anyone who finds the URL can create an account
 * and spend the deployment's provider credits — the app has no other barrier, since it
 * reports on public data and needs no per-user credentials.
 *
 * The row is kept after the account exists rather than deleted, so the owner can see who
 * was let in and revoke a future re-signup.
 */
model Invite {
  id String @id @default(cuid())

  /// Lowercased and trimmed, matching User.email, so the comparison cannot miss.
  email String @unique

  invitedBy   User?   @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById String?

  /// Set when the invited person actually signs up, so the list shows who is still pending.
  acceptedAt DateTime?

  createdAt DateTime @default(now())

  @@index([email])
}

/**
 * One rate-limit window.
 *
 * In-process counters are useless on a serverless host: every instance keeps its own map,
 * so "five signups an hour" becomes five per instance per hour, and a password guesser
 * simply gets spread across instances. This is the same database the app already needs,
 * which is enough for the traffic a tool like this sees.
 */
model RateLimit {
  /// The thing being limited, e.g. `login:203.0.113.4`.
  key String @id

  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/**
 * One Instagram creator in the discovery directory.
 *
 * This is a directory the team maintains by uploading a sheet, not scraped data. Instagram
 * exposes no structured state, city or niche for an account, so those three can only come
 * from a source that already knows them.
 *
 * Every field except the username is nullable: a row with a handle and a city is still
 * worth keeping, and a filter simply will not match it on the fields it lacks.
 */
model Creator {
  id String @id @default(cuid())

  /// Lowercased, no leading "@". The natural key, so re-uploading a sheet updates in place.
  username    String  @unique
  displayName String?

  state String?
  city  String?

  /// Categories as tags, because sheets write them run-on: `Fashion/lifestyle/ugc` is one
  /// creator in three categories, and each should find them.
  niches String[]

  /// The best count known, whatever its source. Everything filters, sorts and displays
  /// this one number, so there is never a second figure to reconcile.
  followers Int?

  /// `sheet` or `live`. Sheets round ("309k"), so a live value is never replaced by a
  /// later import, and the UI can say which one the user is looking at.
  followersSource String?

  /// When the live lookup ran. Null while the count is still the sheet's.
  followersCheckedAt DateTime?

  /// Lowercased. The first readable address when a cell holds several.
  email String?

  /// Digits only, with the country code when the sheet gave one: `919876543210`. Stored
  /// bare so a `tel:`, a `wa.me` link and a copy-paste into a phone all work from one value.
  phone String?

  /**
   * What the creator asks for a post, in whole rupees, as written in the sheet.
   *
   * This is a starting price, not an agreement: what was actually settled on lives on the
   * campaign, per campaign, because it changes every time. Kept separate for that reason —
   * overwriting it from a campaign would lose the number the sheet was maintained with.
   */
  rateCard Int?

  /// Free-text extras from the sheet that do not map to a column, kept so nothing is lost.
  notes String?

  /// Filename of the upload this row last came from, so a bad import can be traced back.
  sourceFile String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Discovery filters on these, and sorts by followers.
  @@index([state])
  @@index([city])
  @@index([followers])
  @@index([state, city])
  /// Array containment needs GIN; a b-tree cannot answer "has this tag".
  @@index([niches], type: Gin)
}

/**
 * One login's Metrics and Engagement work: the uploaded/pasted links, their fetched
 * numbers, and any creator averages already looked up.
 *
 * Held in Postgres rather than process memory because a Vercel deploy is many short-lived
 * instances that do not share a Map. Refresh keeps this row; logout deletes it. The
 * creator directory above is a different thing — it is the team's dataset and outlives
 * any one login.
 */
/**
 * One piece of work for a brand: who is on it, what they owe, and by when.
 *
 * This exists so the team stops keeping a campaign in a spreadsheet. Everything a
 * spreadsheet cannot do — knowing that a deadline has passed, creating the next task when a
 * stage is reached, saying who changed what — is the reason it is a table and not a file.
 */
model Campaign {
  id String @id @default(cuid())

  name  String
  brand String
  brief String?

  startDate DateTime
  endDate   DateTime

  /// Whole rupees. Campaign money is quoted in round numbers, never in paise.
  budget Int?

  /// `PLANNING`, `ACTIVE`, `COMPLETED` or `ON_HOLD`. Set by hand — a campaign is on hold
  /// for reasons no amount of task-counting can infer.
  status String @default("PLANNING")

  manager   User?   @relation("CampaignManager", fields: [managerId], references: [id], onDelete: SetNull)
  managerId String?

  influencers CampaignInfluencer[]
  tasks       Task[]

  activities  Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([endDate])
}

/**
 * One creator on one campaign.
 *
 * Deliberately not a foreign key to `Creator` alone: the directory is Instagram-only and
 * built from uploaded sheets, but a campaign can involve a YouTube channel or someone
 * nobody has added yet. So identity is the platform and handle, and `creatorId` is only a
 * link back when they did come from the directory.
 *
 * Followers and engagement rate are copied in rather than read live. A campaign row is
 * looked at many times a day and every live lookup costs money, so the number is taken once
 * and refreshed when someone asks for it. It also means the rate you agreed a price against
 * stays visible after the account changes.
 */
model CampaignInfluencer {
  id String @id @default(cuid())

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String

  /// `instagram` or `youtube`.
  platform String
  /// Lowercased, no leading "@".
  handle      String
  displayName String?

  /// Set when they came from the directory, so Discovery and the campaign agree.
  creatorId String?

  followers      Int?
  engagementRate Float?
  /// When the two numbers above were taken. Null means they were never looked up.
  statsCheckedAt DateTime?

  /// Whole rupees, as agreed with the creator.
  agreedRate Int?

  /**
   * Whole rupees actually handed over so far.
   *
   * A running total rather than a paid/unpaid flag, because half up front and half on
   * delivery is the normal arrangement, and a flag cannot say which half is outstanding. The
   * status shown on screen is worked out from this against `agreedRate`, so the two can
   * never disagree the way a separately stored status would.
   */
  amountPaid Int @default(0)

  /// Set when the full agreed amount has been paid, so "settled last week" is answerable.
  paidAt DateTime?

  assignedTo   User?   @relation("InfluencerAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?

  /// One of the seven stages in `src/lib/campaigns/status.ts`.
  status String @default("SELECTED")

  deadline DateTime?

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The same person cannot be added to one campaign twice on the same platform.
  @@unique([campaignId, platform, handle])
  @@index([campaignId, status])
  @@index([assignedToId])
  @@index([campaignId, paidAt])
}

/**
 * A piece of work with a name, an owner and a date.
 *
 * There is no stored status. "Overdue" is a fact about the clock and a due date, and a
 * stored copy of it would be wrong every morning until something rewrote it. `startedAt`
 * and `completedAt` are the only state, and the rest is worked out when asked.
 *
 * One table holds both a campaign's tasks and the day's ordinary work. Two would mean an
 * employee has two lists and neither answers "what am I doing today", and it would put the
 * same job in two places to update — which is the thing this module exists to stop.
 */
model Task {
  id String @id @default(cuid())

  /// Null for work that belongs to no campaign — an invoice, a report, a call. Campaign
  /// tasks keep the link, which is what lets finishing one move the campaign along.
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String?

  /// Set when the task exists because of one creator's stage, so it can be shown on
  /// their row. Null for a task somebody typed themselves.
  influencer   CampaignInfluencer? @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  influencerId String?

  name String

  /// What the work is, for whoever picks it up hours after it was assigned.
  description String?

  /// The client this is for, when there is no campaign to name one. A campaign task takes
  /// its brand from the campaign instead, so there is one place to correct a typo.
  brand String?

  /// `HIGH`, `MEDIUM` or `LOW`. The first sort key on every list of tasks, because the
  /// question an employee opens the app with is not "what is next" but "what is first".
  priority String @default("MEDIUM")

  /// GENERAL, or PAYMENT for the task that releasing money creates. Money is owner-only,
  /// so the reader has to be able to tell which tasks are about it — and matching on the
  /// name would break the moment somebody edits one or writes their own.
  kind String @default("GENERAL")

  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?

  /// Who assigned it. Null for the tasks the campaign automation raises by itself, which
  /// is how "nobody asked for this, the system did" stays readable.
  createdBy   User?   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  dueDate DateTime?

  /**
   * Whether `dueDate` carries a time of day or is only a date.
   *
   * A campaign task is due "on Thursday" and is late on Friday. A floor task is due "at
   * 11:00" and is late at 11:01. Both are timestamps in the same column, so without this
   * flag the second kind is indistinguishable from a date that happens to be midnight —
   * and every all-day task would go red at 00:01.
   */
  dueHasTime Boolean @default(false)

  /**
   * Minutes before the deadline to warn the assignee. Null means no warning.
   *
   * Per task rather than one global setting: "tell me 15 minutes before" is right for a
   * call and useless for a day's shortlisting, and the person assigning is the one who
   * knows which it is.
   */
  reminderMinutes Int?

  /// When the warning was shown, so it is shown once rather than on every poll.
  remindedAt DateTime?

  /// When work actually began. This is the timer: it starts here and stops at completedAt.
  startedAt   DateTime?
  completedAt DateTime?

  /**
   * Why it ran long, was late, or is stuck — in the assignee's own words.
   *
   * The point is to find the process that keeps breaking, not to make anyone account for
   * their time. "The data was missing so I checked it by hand" is a fact about the
   * database, and it is only ever learnt by leaving somewhere to write it down.
   */
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, completedAt])
  @@index([assignedToId, completedAt])
  @@index([dueDate])
  @@index([kind])
  /// The floor view: everything unfinished, worst first.
  @@index([completedAt, priority, dueDate])
}

/**
 * One person, one day, when they were here.
 *
 * Written from signing in and out rather than a clock-in button, because a button is one
 * more thing to forget and its absence would read as absence from work.
 *
 * Deliberately thin. Sign-in, last seen, sign-out — enough to answer "has the team
 * started" and no more. Anything finer would be surveillance, would be resented, and would
 * not tell anyone which process is slow, which is the question this module is for.
 */
model WorkDay {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// The Indian calendar date, `YYYY-MM-DD`. A date rather than a timestamp because a
  /// working day is a day, and the team is in one country.
  day String

  /// First sign-in of that day. Later sign-ins do not move it — arriving at nine and
  /// signing in again after lunch is one working day that started at nine.
  signedInAt DateTime

  /// Touched as they use the app, so a day left open by a closed laptop still has an end.
  lastSeenAt DateTime

  /// Set by signing out. Null for a day that was never closed.
  signedOutAt DateTime?

  @@unique([userId, day])
  @@index([day])
}

/**
 * What happened, in one sentence, in the order it happened.
 *
 * The message is written once and stored, rather than rebuilt from ids at read time. A year
 * from now the people and stages it names may have been renamed or deleted, and the history
 * should still read the way it did on the day.
 */
model Activity {
  id String @id @default(cuid())

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String

  actor   User?   @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId String?

  /// Groups the history for filtering: `influencer_added`, `status_changed`,
  /// `task_completed`, `task_added`, `note`.
  kind String

  message String

  createdAt DateTime @default(now())

  @@index([campaignId, createdAt])
}

model WorkSession {
  /// Matches the `sid` in the signed cookie.
  sid String @id

  payload Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}
